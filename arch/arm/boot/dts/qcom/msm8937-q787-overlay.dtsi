01 00 00 00 00 02 00 02 29 01 00 00 00 00 02 02 23 29 01 00 00 00 00 02 03 8f 29 01 00 00 00 00 02 09 11 29 01 00 00 00 00 02 0e 2a 29 01 00 00 00 00 02 9a 01 29 01 00 00 00 00 02 9b 05 29 01 00 00 00 00 02 a9 01 29 01 00 00 00 00 02 aa 68 29 01 00 00 00 00 02 ac 19 29 01 00 00 00 00 02 ad 0f 29 01 00 00 00 00 02 ae 0f 29 01 00 00 00 00 02 e0 00 29 01 00 00 00 00 02 e6 02 29 01 00 00 00 00 02 e7 06 29 01 00 00 00 00 02 e0 00 29 01 00 00 00 00 01 11 29 01 00 00 00 00 01 29 29 01 00 00 00 00 02 35 00];
		qcom,mdss-dsi-off-command = [05 01 00 00 32 00 02 28 00
					     05 01 00 00 78 00 02 10 00];
		qcom,mdss-dsi-on-command-state = "dsi_lp_mode";
		qcom,mdss-dsi-off-command-state = "dsi_hs_mode";
		qcom,mdss-dsi-h-sync-pulse = <0x1>;
		qcom,mdss-dsi-traffic-mode = "burst_mode";
		qcom,mdss-dsi-lane-map = "lane_map_0123";
		qcom,mdss-dsi-bllp-eof-power-mode;
		qcom,mdss-dsi-bllp-power-mode;
		qcom,mdss-dsi-lane-0-state;
		qcom,mdss-dsi-lane-1-state;
		qcom,mdss-dsi-lane-2-state;
		qcom,mdss-dsi-lane-3-state;
		qcom,mdss-dsi-panel-timings = <0x7b1a1000 0x3e40161e 0x15030400>;
		qcom,mdss-dsi-t-clk-post = <0x4>;
		qcom,mdss-dsi-t-clk-pre = <0x1a>;
		qcom,mdss-dsi-force-clock-lane-hs;
		qcom,mdss-dsi-bl-min-level = <0x1>;
		qcom,mdss-dsi-bl-max-level = <0xfff>;
		qcom,mdss-dsi-dma-trigger = "trigger_sw";
		qcom,mdss-dsi-mdp-trigger = "none";
		qcom,mdss-dsi-bl-pmic-control-type = "bl_ctrl_wled";
		qcom,mdss-dsi-reset-sequence = <0x1 0x0 0x1 0x5 0xa 0x78>;
		qcom,cont-splash-enabled;
		qcom,panel-supply-entries = <&q787_panel_pwr>;
	};
};

/* Выбор основной панели */
&mdss_dsi0 {
	qcom,dsi-pref-prim-pan = <&jd9366d_vid>;
};
