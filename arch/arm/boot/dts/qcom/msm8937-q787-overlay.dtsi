/*
 * Jason Q787 (ZXH-Q787): отличия от generic msm8937-pmi8937-qrd-sku2
 * Подключается в msm8937-pmi8937-qrd-sku2-dvt1.dts ПОСЛЕ базового include:
 *   #include "msm8937-pmi8937-qrd-sku2.dtsi"
 *   #include "msm8937-q787-overlay.dtsi"
 */

/* ============================================================
   1. PINCTRL: клавиши ptt/sos + UART5 (peripheral-порт ODM)
   Группы тача (pmx_ts_*) и NFC (pmx_rd_nfc_int/pmx_nfc_reset)
   в базе уже правильные — НЕ дублируем их здесь.
   ============================================================ */
&tlmm_pinmux {
	tlmm_gpio_key {
		gpio_key_active {
			mux {
				pins = "gpio91", "gpio127", "gpio128";
				function = "gpio";
			};
			config {
				pins = "gpio91", "gpio127", "gpio128";
				drive-strength = <0x2>;
				bias-pull-up;
			};
		};

		gpio_key_suspend {
			mux {
				pins = "gpio91", "gpio127", "gpio128";
				function = "gpio";
			};
			config {
				pins = "gpio91", "gpio127", "gpio128";
				drive-strength = <0x2>;
				bias-pull-up;
			};
		};
	};

	blsp2_uart1_active {
		mux {
			pins = "gpio16", "gpio17";
			function = "blsp_uart5";
		};
		config {
			pins = "gpio16", "gpio17";
			drive-strength = <0x2>;
			bias-disable;
		};
	};

	blsp2_uart1_sleep {
		mux {
			pins = "gpio16", "gpio17";
			function = "blsp_uart5";
		};
		config {
			pins = "gpio16", "gpio17";
			drive-strength = <0x2>;
			bias-pull-down;
		};
	};
};

/* ============================================================
   2. УСТРОЙСТВА
   ============================================================ */
&soc {

	/* --- Тачскрин Goodix GT5688 (i2c 3-005d) --- */
	i2c@78b7000 {
		/* чужой тач из QRD-базы — убрать, иначе конфликт на шине */
		/delete-node/ focaltech@38;

		goodix@5d {
			compatible = "goodix,gt1x";
			reg = <0x5d>;
			interrupt-parent = <&tlmm_pinmux>;
			interrupts = <65 0x2008>;
			goodix,rst-gpio = <&tlmm_pinmux 64 0x0>;
			goodix,irq-gpio = <&tlmm_pinmux 65 0x2002>;
			vdd-supply = <&pm8937_l10>;
			vcc_i2c-supply = <&pm8937_l6>;
			pinctrl-names = "pmx_ts_active", "pmx_ts_suspend", "pmx_ts_release";
			pinctrl-0 = <&ts_int_active &ts_reset_active>;
			pinctrl-1 = <&ts_int_suspend &ts_reset_suspend>;
			pinctrl-2 = <&ts_release>;
			goodix,product-id = "5688";
			goodix,name = "GT5688";
			goodix,fw-vkey-support;
		};
	};

	/* --- NFC NXP pn548 (i2c 5-0028) --- */
	i2c@7af5000 {
		/* если в QRD-базе на этой шине есть свой NFC — раскомментируйте: */
		/* /delete-node/ nq-nci@28; */

		pn548@28 {
			compatible = "NXP,pn548";
			reg = <0x28>;
			vdd-supply = <&pm8937_l10>;
			vcc_i2c-supply = <&pm8937_l6>;
			interrupt-parent = <&tlmm_pinmux>;
			interrupts = <126 0x0>;
			irq-gpio = <&tlmm_pinmux 126 0x0>;
			ven-gpio = <&tlmm_pinmux 132 0x0>;
			firm-gpio = <&tlmm_pinmux 130 0x0>;
		};
	};

	/* --- UART5 на gpio16/17 (периферийный порт ODM) --- */
	serial@7aef000 {
		compatible = "qcom,msm-lsuart-v14";
		reg = <0x7aef000 0x200>;
		interrupts = <0x0 306 0x0>;
		status = "ok";
		clocks = <&clock_gcc clk_gcc_blsp1_uart5_apps_clk>,
			 <&clock_gcc clk_gcc_blsp1_ahb_clk>;
		clock-names = "core_clk", "iface_clk";
		pinctrl-names = "sleep", "default";
		pinctrl-0 = <&blsp2_uart1_sleep>;
		pinctrl-1 = <&blsp2_uart1_active>;
	};

	/* --- Клавиши: ptt/sos (vol_up gpio91 остаётся из базы) --- */
	gpio_keys {
		compatible = "gpio-keys";
		input-name = "gpio-keys";

		ptt_key {
			label = "ptt_key";
			gpios = <&tlmm_pinmux 127 0x1>;
			linux,input-type = <0x1>;
			linux,code = <476>;
			gpio-key,wakeup;
			debounce-interval = <0xf>;
		};

		sos_key {
			label = "sos_key";
			gpios = <&tlmm_pinmux 128 0x1>;
			linux,input-type = <0x1>;
			linux,code = <477>;
			gpio-key,wakeup;
			debounce-interval = <0xf>;
		};
	};

	/* --- Виртуальные клавиши тача --- */
	gen-vkeys {
		compatible = "qcom,gen-vkeys";
		label = "goodix_ts";
		qcom,disp-maxx = <1080>;
		qcom,disp-maxy = <1920>;
		qcom,panel-maxx = <1080>;
		qcom,panel-maxy = <2098>;
		qcom,key-codes = <139 172 158>;
		qcom,y-offset = <0x0>;
	};

	/* --- ODM: GPIO-интерфейс питания RFID --- */
	pwv,gpio-interface {
		compatible = "pwv,gpio-interface";

		rfid-power {
			pwv,lable = "rfid-power";
			gpios = <&tlmm_pinmux 59 0x0>;
		};
	};

	/* ============================================================
	   3. ДИСПЛЕЙ: питание панели + узел jd9366d
	   ============================================================ */
	q787_panel_pwr: dsi_panel_pwr_supply {
		#address-cells = <0x1>;
		#size-cells = <0x0>;

		qcom,panel-supply-entry@0 {
			reg = <0x0>;
			qcom,supply-name = "vdd";
			qcom,supply-min-voltage = <0x2b7cd0>;   /* 2,85 В */
			qcom,supply-max-voltage = <0x2b7cd0>;
			qcom,supply-enable-load = <0x186a0>;
			qcom,supply-disable-load = <0x64>;
		};

		qcom,panel-supply-entry@1 {
			reg = <0x1>;
			qcom,supply-name = "vddio";
			qcom,supply-min-voltage = <0x1b7740>;   /* 1,8 В */
			qcom,supply-max-voltage = <0x1b7740>;
			qcom,supply-enable-load = <0x186a0>;
			qcom,supply-disable-load = <0x64>;
		};
	};

	jd9366d_vid: qcom,mdss_dsi_jd9366d_720p_video {
		qcom,mdss-dsi-panel-name = "jd9366d 720p video mode dsi panel";
		qcom,mdss-dsi-panel-controller = <&mdss_dsi0>;
		qcom,mdss-dsi-panel-type = "dsi_video_mode";
		qcom,mdss-dsi-panel-destination = "display_1";
		qcom,mdss-dsi-panel-framerate = <0x3c>;
		qcom,mdss-dsi-virtual-channel-id = <0x0>;
		qcom,mdss-dsi-stream = <0x0>;
		qcom,mdss-dsi-panel-width = <0x2d0>;    /* 720 */
		qcom,mdss-dsi-panel-height = <0x5a0>;   /* 1440 */
		qcom,mdss-dsi-h-front-porch = <0x1a>;
		qcom,mdss-dsi-h-back-porch = <0x1a>;
		qcom,mdss-dsi-h-pulse-width = <0x8>;
		qcom,mdss-dsi-h-sync-skew = <0x0>;
		qcom,mdss-dsi-v-back-porch = <0x8>;
		qcom,mdss-dsi-v-front-porch = <0x24>;
		qcom,mdss-dsi-v-pulse-width = <0x4>;
		qcom,mdss-dsi-h-left-border = <0x0>;
		qcom,mdss-dsi-h-right-border = <0x0>;
		qcom,mdss-dsi-v-top-border = <0x0>;
		qcom,mdss-dsi-v-bottom-border = <0x0>;
		qcom,mdss-dsi-bpp = <0x18>;
		qcom,mdss-dsi-color-order = "rgb_swap_rgb";
		qcom,mdss-dsi-underflow-color = <0xff>;
		qcom,mdss-dsi-border-color = <0x0>;

		qcom,mdss-dsi-on-command = [29 01 00 00 00 00 02 e0 00 29 01 00 00 00 00 02 e1 93 29 01 00 00 00 00 02 e2 66 29 01 00 00 00 00 02 e3 f9 29 01 00 00 00 00 02 80 03 29 01 00 00 00 00 02 e0 01 29 01 00 00 00 00 02 00 01 29 01 00 00 00 00 02 01 25 29 01 00 00 00 00 02 03 01 29 01 00 00 00 00 02 04 24 29 01 00 00 00 00 02 0a 08 29 01 00 00 00 00 02 13 00 29 01 00 00 00 00 02 14 99 29 01 00 00 00 00 02 17 00 29 01 00 00 00 00 02 18 a4 29 01 00 00 00 00 02 19 00 29 01 00 00 00 00 02 1a 00 29 01 00 00 00 00 02 1b a4 29 01 00 00 00 00 02 1c 00 29 01 00 00 00 00 02 1f 32 29 01 00 00 00 00 02 20 2f 29 01 00 00 00 00 02 21 19 29 01 00 00 00 00 02 22 0d 29 01 00 00 00 00 02 23 02 29 01 00 00 00 00 02 24 fe 29 01 00 00 00 00 02 26 dd 29 01 00 00 00 00 02 35 13 29 01 00 00 00 00 02 37 09 29 01 00 00 00 00 02 38 04 29 01 00 00 00 00 02 39 01 29 01 00 00 00 00 02 3a 03 29 01 00 00 00 00 02 3c 60 29 01 00 00 00 00 02 3d 18 29 01 00 00 00 00 02 3e 80 29 01 00 00 00 00 02 3f 4e 29 01 00 00 00 00 02 3d ff 29 01 00 00 00 00 02 3e ff 29 01 00 00 00 00 02 3f ff 29 01 00 00 00 00 02 4b 04 29 01 00 00 00 00 02 40 04 29 01 00 00 00 00 02 41 b4 29 01 00 00 00 00 02 42 70 29 01 00 00 00 00 02 43 24 29 01 00 00 00 00 02 44 0c 29 01 00 00 00 00 02 45 64 29 01 00 00 00 00 02 55 01 29 01 00 00 00 00 02 56 01 29 01 00 00 00 00 02 57 6d 29 01 00 00 00 00 02 58 0a 29 01 00 00 00 00 02 59 8a 29 01 00 00 00 00 02 5a 28 29 01 00 00 00 00 02 5b 23 29 01 00 00 00 00 02 5c 15 29 01 00 00 00 00 02 5d 75 29 01 00 00 00 00 02 5e 5b 29 01 00 00 00 00 02 5f 4b 29 01 00 00 00 00 02 60 3f 29 01 00 00 00 00 02 61 3c 29 01 00 00 00 00 02 62 2d 29 01 00 00 00 00 02 63 33 29 01 00 00 00 00 02 64 1d 29 01 00 00 00 00 02 65 37 29 01 00 00 00 00 02 66 37 29 01 00 00 00 00 02 67 39 29 01 00 00 00 00 02 68 59 29 01 00 00 00 00 02 69 4a 29 01 00 00 00 00 02 6a 54 29 01 00 00 00 00 02 6b 47 29 01 00 00 00 00 02 6c 44 29 01 00 00 00 00 02 6d 37 29 01 00 00 00 00 02 6e 27 29 01 00 00 00 00 02 6f 1a 29 01 00 00 00 00 02 70 75 29 01 00 00 00 00 02 71 5b 29 01 00 00 00 00 02 72 4b 29 01 00 00 00 00 02 73 3f 29 01 00 00 00 00 02 74 3c 29 01 00 00 00 00 02 75 2d 29 01 00 00 00 00 02 76 33 29 01 00 00 00 00 02 77 1d 29 01 00 00 00 00 02 78 37 29 01 00 00 00 00 02 79 37 29 01 00 00 00 00 02 7a 39 29 01 00 00 00 00 02 7b 59 29 01 00 00 00 00 02 7c 4a 29 01 00 00 00 00 02 7d 54 29 01 00 00 00 00 02 7e 47 29 01 00 00 00 00 02 7f 44 29 01 00 00 00 00 02 80 37 29 01 00 00 00 00 02 81 27 29 01 00 00 00 00 02 82 1a 29 01 00 00 00 00 02 e0 02 29 01 00 00 00 00 02 00 5d 29 01 00 00 00 00 02 01 51 29 01 00 00 00 00 02 02 5d 29 01 00 00 00 00 02 03 5d 29 01 00 00 00 00 02 04 5e 29 01 00 00 00 00 02 05 5f 29 01 00 00 00 00 02 06 51 29 01 00 00 00 00 02 07 41 29 01 00 00 00 00 02 08 45 29 01 00 00 00 00 02 09 5d 29 01 00 00 00 00 02 0a 5d 29 01 00 00 00 00 02 0b 4b 29 01 00 00 00 00 02 0c 49 29 01 00 00 00 00 02 0d 5d 29 01 00 00 00 00 02 0e 5d 29 01 00 00 00 00 02 0f 47 29 01 00 00 00 00 02 10 5f 29 01 00 00 00 00 02 11 5d 29 01 00 00 00 00 02 12 5d 29 01 00 00 00 00 02 13 5d 29 01 00 00 00 00 02 14 5d 29 01 00 00 00 00 02 15 5d 29 01 00 00 00 00 02 16 5d 29 01 00 00 00 00 02 17 50 29 01 00 00 00 00 02 18 5d 29 01 00 00 00 00 02 19 5d 29 01 00 00 00 00 02 1a 5e 29 01 00 00 00 00 02 1b 5f 29 01 00 00 00 00 02 1c 50 29 01 00 00 00 00 02 1d 40 29 01 00 00 00 00 02 1e 44 29 01 00 00 00 00 02 1f 5d 29 01 00 00 00 00 02 20 5d 29 01 00 00 00 00 02 21 4a 29 01 00 00 00 00 02 22 48 29 01 00 00 00 00 02 23 5d 29 01 00 00 00 00 02 24 5d 29 01 00 00 00 00 02 25 46 29 01 00 00 00 00 02 26 5f 29 01 00 00 00 00 02 27 5d 29 01 00 00 00 00 02 28 5d 29 01 00 00 00 00 02 29 5d 29 01 00 00 00 00 02 2a 5d 29 01 00 00 00 00 02 2b 5d 29 01 00 00 00 00 02 2c 1d 29 01 00 00 00 00 02 2d 10 29 01 00 00 00 00 02 2e 1d 29 01 00 00 00 00 02 2f 1d 29 01 00 00 00 00 02 30 1f 29 01 00 00 00 00 02 31 1e 29 01 00 00 00 00 02 32 00 29 01 00 00 00 00 02 33 10 29 01 00 00 00 00 02 34 06 29 01 00 00 00 00 02 35 1d 29 01 00 00 00 00 02 36 1d 2